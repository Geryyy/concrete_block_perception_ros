Panels:
  - Class: rviz_common/Displays
    Help Height: 70
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1
        - /RobotModel Rigid1/Description Topic1
        - /IMUs1/IMU161/Acceleration properties1
        - /IMUs1/IMU151/Acceleration properties1
        - /IMUs1/IMU141/Axes properties1
        - /IMUs1/IMU131/Acceleration properties1
        - /IMUs1/IMU121
        - /Planning and Control1
        - /Perception1
        - /PointCloud21
        - /PointCloud22
      Splitter Ratio: 0.762273907661438
    Tree Height: 97
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
      - /Log Picker1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  # TimberCranePanel, MotionPlanningPanel, BehaviorTreePanel and
  # AssemblyWorkflowPanel are deliberately absent: this bench runs no
  # controller_manager, no motion planning and no BT action server.
  # TimberCranePanel in particular polls controller_manager on a 1 Hz timer
  # with a blocking wait_for_service(1s), so with no controller_manager it
  # blocks ~every second and starves the callbacks the Perception panel needs.
  - Class: concrete_block_rviz_plugins/PerceptionControlPanel
    ClearWorldService: /world_model_node/clear_world_model
    EnableDebug: true
    Name: PerceptionControlPanel
    RefineGraspedUseTarget: false
    RunPoseService: /world_model_node/run_pose_estimation
    TargetBlockId: block_0
    TaskStatusService: /world_model_node/set_block_task_status
    TimeoutS: 8
  - Class: concrete_block_rviz_plugins/PlanControlPanel
    Name: PlanControlPanel
    PlanControlService: /concrete_block_wall_plan_server/plan_control
    WallPlansFile: /workspaces/ros2_baustelle_ws/src/concrete_block_stack/concrete_block_assembly_planning/config/wall_plans.yaml
